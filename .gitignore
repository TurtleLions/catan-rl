models/*
!models/V2a_s*.npz
!models/V2b_s*.npz
!models/V2c_s*.npz
!models/*.txt
!models/M0_s*.npz
!models/M0e_s*.npz
!models/A20biga_s*.npz
!models/A20bigb_s*.npz
!models/N1_s*.npz
!models/P1.npz
!models/Q1_s*.npz
!models/P4a.npz
