diff --git a/ui/src/components/TradeDialog.tsx b/ui/src/components/TradeDialog.tsx
new file mode 100644
index 0000000..68c1d20
--- /dev/null
+++ b/ui/src/components/TradeDialog.tsx
@@ -0,0 +1,108 @@
+import { useState } from "react";
+import {
+  Dialog,
+  DialogTitle,
+  DialogContent,
+  DialogActions,
+  Button,
+} from "@mui/material";
+import type { ResourceCard } from "../utils/api.types";
+import { RESOURCE_ORDER, tradeBundle } from "../utils/promptUtils";
+
+import "./TradeDialog.scss";
+
+type TradeDialogProps = {
+  open: boolean;
+  hand: number[]; // cards in hand, in RESOURCE_ORDER
+  onClose: () => void;
+  onOffer: (value: number[]) => void; // 5 to give, then 5 wanted
+};
+
+/** Builds an offer to the other players: cards to give for cards wanted. */
+export default function TradeDialog({
+  open,
+  hand,
+  onClose,
+  onOffer,
+}: TradeDialogProps) {
+  const [give, setGive] = useState([0, 0, 0, 0, 0]);
+  const [want, setWant] = useState([0, 0, 0, 0, 0]);
+
+  // A resource is on one side of the offer only.
+  const step = (side: "give" | "want", i: number, delta: number) => {
+    const g = [...give];
+    const w = [...want];
+    if (side === "give") {
+      g[i] = Math.min(hand[i], Math.max(0, g[i] + delta));
+      if (g[i] > 0) w[i] = 0;
+    } else {
+      w[i] = Math.min(19, Math.max(0, w[i] + delta));
+      if (w[i] > 0) g[i] = 0;
+    }
+    setGive(g);
+    setWant(w);
+  };
+  const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
+  const valid = sum(give) > 0 && sum(want) > 0;
+  const close = () => {
+    setGive([0, 0, 0, 0, 0]);
+    setWant([0, 0, 0, 0, 0]);
+    onClose();
+  };
+
+  const stepper = (side: "give" | "want", i: number) => {
+    const n = side === "give" ? give[i] : want[i];
+    const max = side === "give" ? hand[i] : 19;
+    return (
+      <div className="stepper">
+        <Button disabled={n === 0} onClick={() => step(side, i, -1)}>
+          −
+        </Button>
+        <span className="count">{n}</span>
+        <Button disabled={n >= max} onClick={() => step(side, i, 1)}>
+          +
+        </Button>
+      </div>
+    );
+  };
+
+  return (
+    <Dialog open={open} onClose={close} className="trade-dialog" maxWidth="xs" fullWidth>
+      <DialogTitle>Offer a trade</DialogTitle>
+      <DialogContent>
+        <div className="trade-grid">
+          <span />
+          <span className="head">You give</span>
+          <span className="head">You get</span>
+          {RESOURCE_ORDER.map((r: ResourceCard, i) => (
+            <div className="trade-row" key={r}>
+              <span className={`resource-name ${r.toLowerCase()}`}>
+                {r} <span className="held">({hand[i]})</span>
+              </span>
+              {stepper("give", i)}
+              {stepper("want", i)}
+            </div>
+          ))}
+        </div>
+        <p className="summary">
+          {valid
+            ? `${tradeBundle(give)} for ${tradeBundle(want)}`
+            : "Pick cards to give and cards you want."}
+        </p>
+      </DialogContent>
+      <DialogActions>
+        <Button onClick={close}>Cancel</Button>
+        <Button
+          variant="contained"
+          disabled={!valid}
+          onClick={() => {
+            onOffer([...give, ...want]);
+            close();
+          }}
+        >
+          Offer to everyone
+        </Button>
+      </DialogActions>
+    </Dialog>
+  );
+}
