@@ -0,0 +1,80 @@
+import { useContext } from "react";
+import { Button } from "@mui/material";
+import { useParams } from "react-router-dom";
+import { useSnackbar } from "notistack";
+
+import { store } from "../store";
+import ACTIONS from "../actions";
+import type { Color, GameAction, GameState } from "../utils/api.types";
+import { postAction } from "../utils/apiClient";
+import { tradeBundle } from "../utils/promptUtils";
+import { dispatchSnackbar } from "./Snackbar";
+
+import "./TradeDialog.scss";
+
+/** Shown instead of the play buttons while the human answers an offer
+ * (DECIDE_TRADE) or picks whom to trade with (DECIDE_ACCEPTEES). */
+export default function TradePanel({ gameState }: { gameState: GameState }) {
+  const { gameId } = useParams();
+  const { dispatch } = useContext(store);
+  const { enqueueSnackbar, closeSnackbar } = useSnackbar();
+
+  const play = (action: GameAction) => async () => {
+    if (!gameId) return;
+    const next = await postAction(gameId, action);
+    dispatch({ type: ACTIONS.SET_GAME_STATE, data: next });
+    dispatchSnackbar(enqueueSnackbar, closeSnackbar, next);
+  };
+  const trade = gameState.current_trade;
+  const give = tradeBundle(trade.slice(0, 5));
+  const want = tradeBundle(trade.slice(5, 10));
+  const actions = gameState.current_playable_actions;
+  const find = (type: string) => actions.find((a) => a[1] === type);
+
+  if (gameState.current_prompt === "DECIDE_TRADE") {
+    const offerer = gameState.colors[trade[10]];
+    const accept = find("ACCEPT_TRADE");
+    const reject = find("REJECT_TRADE");
+    return (
+      <div className="trade-panel">
+        <div className="trade-text">
+          <span className={`who ${offerer}`}>{offerer}</span> offers {give} for
+          your {want}
+          {!accept && <em> (you don't have the cards)</em>}
+        </div>
+        <div className="trade-buttons">
+          <Button variant="contained" disabled={!accept} onClick={accept && play(accept)}>
+            Accept
+          </Button>
+          <Button variant="contained" color="secondary" onClick={reject && play(reject)}>
+            Decline
+          </Button>
+        </div>
+      </div>
+    );
+  }
+
+  // DECIDE_ACCEPTEES: the human offered and at least one player accepted.
+  const confirms = actions.filter((a) => a[1] === "CONFIRM_TRADE");
+  const cancel = find("CANCEL_TRADE");
+  return (
+    <div className="trade-panel">
+      <div className="trade-text">
+        Your {give} for {want}: accepted by
+      </div>
+      <div className="trade-buttons">
+        {confirms.map((a) => {
+          const partner = (a[2] as unknown[])[10] as Color;
+          return (
+            <Button key={partner} variant="contained" className={`who-btn ${partner}`} onClick={play(a)}>
+              {partner}
+            </Button>
+          );
+        })}
+        <Button variant="contained" color="secondary" onClick={cancel && play(cancel)}>
+          Call off
+        </Button>
+      </div>
+    </div>
+  );
+}
